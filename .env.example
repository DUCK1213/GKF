# ========================================================
# Geoffrey Karema Foundation (GKF) Environment Variables
# PostgreSQL / Supabase Database Pipeline Configuration
# ========================================================

# Database URLs
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
DATABASE_SESSION_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Project Endpoints
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_PROJECT_REF="[PROJECT_REF]"
SUPABASE_DB_HOST="aws-1-[REGION].pooler.supabase.com"
SUPABASE_DB_PORT="6543"
SUPABASE_DB_USER="postgres.[PROJECT_REF]"
SUPABASE_DB_PASSWORD="[PASSWORD]"
SUPABASE_DB_NAME="postgres"
